# ── Django ──────────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://ucuser:ucpass@localhost:5432/unifiedcomm
DB_CONN_MAX_AGE=600

# ── Redis / Caches ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_MAX_CONNECTIONS=50

# ── Django Channels (WebSockets) ─────────────────────────────────────────────
# Ephemeral events (presence/typing) can be dropped if client buffer overflows;
# critical state relies on PostgreSQL + OutboxEvent.
CHANNELS_CAPACITY=1500
CHANNELS_EXPIRY=10

# ── Celery Workers ───────────────────────────────────────────────────────────
# Tune based on actual workload and media file sizes. Stream media instead of buffering.
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000
CELERY_WORKER_MAX_MEMORY_PER_CHILD=200000

# ── CORS & CSRF ──────────────────────────────────────────────────────────────
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://api.tcxconnect.tech,https://app.tcxconnect.tech,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=https://api.tcxconnect.tech,https://app.tcxconnect.tech,http://localhost:5173,http://127.0.0.1:5173
